<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ChaosLockArena" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="WF_Chaos_LockArena" name="WF Chaos Lock Arena" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="LockArenaStart" name="Start">
      <bpmn:outgoing>Flow_ToArenaTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToArenaTask" sourceRef="LockArenaStart" targetRef="lockArenaTask" />
    <bpmn:serviceTask id="lockArenaTask" name="Lock Arena Task" camunda:type="external" camunda:topic="lockArena">
      <bpmn:incoming>Flow_ToArenaTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ToArenaEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToArenaEnd" sourceRef="lockArenaTask" targetRef="LockArenaEnd" />
    <bpmn:endEvent id="LockArenaEnd" name="End">
      <bpmn:incoming>Flow_ToArenaEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
